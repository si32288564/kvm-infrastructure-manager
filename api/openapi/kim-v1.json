{
  "openapi": "3.1.0",
  "info": {
    "title": "KIM Northbound API",
    "version": "1.0.0-phase1",
    "description": "Spec-first HTTP contract. KIM lifecycle metadata classifies persistent desired fields separately from computed and immutable fields."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"oauth2": []}],
  "paths": {
    "/projects": {
      "post": {
        "operationId": "createProject",
        "parameters": [
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/RequestID"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectCreate"}}}},
        "responses": {
          "201": {"description": "Project authority committed synchronously", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}, "Location": {"schema": {"type": "string"}}, "X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}},
          "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      },
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 128}},
          {"$ref": "#/components/parameters/RequestID"}
        ],
        "responses": {
          "200": {"description": "Scope-filtered stable Project page", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectPage"}}}},
          "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/projects/{project_id}": {
      "parameters": [{"$ref": "#/components/parameters/ProjectID"}, {"$ref": "#/components/parameters/RequestID"}],
      "get": {
        "operationId": "getProject",
        "responses": {
          "200": {"description": "Current authorized Project desired projection", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}, "X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}},
          "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      },
      "patch": {
        "operationId": "updateProject",
        "parameters": [{"$ref": "#/components/parameters/IfMatch"}],
        "requestBody": {"required": true, "content": {"application/merge-patch+json": {"schema": {"$ref": "#/components/schemas/ProjectPatch"}}, "application/json": {"schema": {"$ref": "#/components/schemas/ProjectPatch"}}}},
        "responses": {
          "200": {"description": "Project desired revision committed synchronously", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}, "X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Project"}}}},
          "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "parameters": [{"$ref": "#/components/parameters/IfMatch"}],
        "responses": {
          "204": {"description": "Project tombstone committed synchronously", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestID"}}},
          "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "404": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "412": {"$ref": "#/components/responses/Problem"}, "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/flavors": {
      "post": {
        "operationId": "createFlavor",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FlavorDesired"}}}},
        "responses": {"201": {"description": "Flavor revision committed synchronously", "headers": {"ETag": {"$ref": "#/components/headers/ETag"}, "Location": {"schema": {"type": "string"}}, "X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Flavor"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Problem"}, "403": {"$ref": "#/components/responses/Problem"}, "409": {"$ref": "#/components/responses/Problem"}, "413": {"$ref": "#/components/responses/Problem"}}
      },
      "get": {
        "operationId": "listFlavors",
        "parameters": [{"name":"projectId","in":"query","schema":{"$ref":"#/components/schemas/ProjectID"}}, {"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}, {"name":"cursor","in":"query","schema":{"type":"string","maxLength":128}}, {"$ref":"#/components/parameters/RequestID"}],
        "responses": {"200":{"description":"Authorized stable Flavor page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FlavorPage"}}}},"400":{"$ref":"#/components/responses/Problem"},"401":{"$ref":"#/components/responses/Problem"}}
      }
    },
    "/flavors/{flavor_id}": {
      "parameters": [{"name":"flavor_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/FlavorID"}}, {"$ref":"#/components/parameters/RequestID"}],
      "get": {"operationId":"getFlavor","responses":{"200":{"description":"Current Flavor desired projection","headers":{"ETag":{"$ref":"#/components/headers/ETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Flavor"}}}},"401":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"}}},
      "patch": {"operationId":"updateFlavor","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/merge-patch+json":{"schema":{"$ref":"#/components/schemas/FlavorPatch"}},"application/json":{"schema":{"$ref":"#/components/schemas/FlavorPatch"}}}},"responses":{"200":{"description":"New immutable Flavor revision committed","headers":{"ETag":{"$ref":"#/components/headers/ETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Flavor"}}}},"400":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"412":{"$ref":"#/components/responses/Problem"}}},
      "delete": {"operationId":"deleteFlavor","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"204":{"description":"Unreferenced Flavor tombstoned synchronously"},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"409":{"$ref":"#/components/responses/Problem"},"412":{"$ref":"#/components/responses/Problem"}}}
    },
    "/availability-policies": {
      "post":{"operationId":"createAvailabilityPolicy","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/RequestID"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicyDesired"}}}},"responses":{"201":{"description":"SYSTEM Availability Policy revision committed synchronously","headers":{"ETag":{"$ref":"#/components/headers/ETag"},"Location":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicy"}}}},"400":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"},"409":{"$ref":"#/components/responses/Problem"}}},
      "get":{"operationId":"listAvailabilityPolicies","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"cursor","in":"query","schema":{"type":"string","maxLength":128}},{"$ref":"#/components/parameters/RequestID"}],"responses":{"200":{"description":"Authorized stable Availability Policy page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicyPage"}}}},"400":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"}}}
    },
    "/availability-policies/{policy_id}": {
      "parameters":[{"name":"policy_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/AvailabilityPolicyID"}},{"$ref":"#/components/parameters/RequestID"}],
      "get":{"operationId":"getAvailabilityPolicy","responses":{"200":{"description":"Current persistent Availability intent","headers":{"ETag":{"$ref":"#/components/headers/ETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicy"}}}},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"}}},
      "patch":{"operationId":"updateAvailabilityPolicy","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/merge-patch+json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicyPatch"}},"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicyPatch"}}}},"responses":{"200":{"description":"New immutable Availability Policy revision committed without workload retrofit","headers":{"ETag":{"$ref":"#/components/headers/ETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityPolicy"}}}},"400":{"$ref":"#/components/responses/Problem"},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"412":{"$ref":"#/components/responses/Problem"}}},
      "delete":{"operationId":"deleteAvailabilityPolicy","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"204":{"description":"Unreferenced policy retired synchronously"},"403":{"$ref":"#/components/responses/Problem"},"404":{"$ref":"#/components/responses/Problem"},"409":{"$ref":"#/components/responses/Problem"},"412":{"$ref":"#/components/responses/Problem"}}}
    },
    "/images": {
      "post":{"operationId":"createImage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImageDesired"}}}},"responses":{"201":{"description":"Logical Image revision committed; artifact remains PENDING","headers":{"ETag":{"$ref":"#/components/headers/ETag"},"Location":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Image"}}}},"400":{"$ref":"#/components/responses/Problem"},"409":{"$ref":"#/components/responses/Problem"}}},
      "get":{"operationId":"listImages","parameters":[{"name":"projectId","in":"query","schema":{"$ref":"#/components/schemas/ProjectID"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Authorized Image page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImagePage"}}}}}}
    },
    "/images/{image_id}": {
      "parameters":[{"name":"image_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ImageID"}}],
      "get":{"operationId":"getImage","responses":{"200":{"description":"Logical Image plus computed verification","headers":{"ETag":{"$ref":"#/components/headers/ETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Image"}}}}}},
      "patch":{"operationId":"updateImage","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/merge-patch+json":{"schema":{"$ref":"#/components/schemas/ImagePatch"}}}},"responses":{"200":{"description":"New logical revision; verified content is never replaced silently","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Image"}}}}}},
      "delete":{"operationId":"deleteImage","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"204":{"description":"Unreferenced logical Image tombstoned"},"409":{"$ref":"#/components/responses/Problem"}}}
    },
    "/images/{image_id}/ingestions": {
      "post":{"operationId":"ingestImageArtifact","parameters":[{"name":"image_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/ImageID"}},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"202":{"description":"Typed ingestion accepted; command response is not convergence","headers":{"Location":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Operation"}}}},"409":{"$ref":"#/components/responses/Problem"},"412":{"$ref":"#/components/responses/Problem"}}}
    },
    "/networks": {"post":{"operationId":"createNetwork","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NetworkDesired"}}}},"responses":{"201":{"description":"Logical Network committed; realization is asynchronous","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Network"}}}}}},"get":{"operationId":"listNetworks","responses":{"200":{"description":"Authorized Network page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NetworkPage"}}}}}}},
    "/networks/{resource_id}": {"get":{"operationId":"getNetwork","responses":{"200":{"description":"Current logical Network","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Network"}}}}}},"patch":{"operationId":"updateNetwork","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/merge-patch+json":{"schema":{"$ref":"#/components/schemas/NetworkPatch"}}}},"responses":{"200":{"description":"New desired revision and realization Operation"}}},"delete":{"operationId":"deleteNetwork","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"202":{"description":"Dependency-fenced retirement Operation accepted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Operation"}}}}}}},
    "/subnets": {"post":{"operationId":"createSubnet","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubnetDesired"}}}},"responses":{"201":{"description":"Logical Subnet/IPAM authority committed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Subnet"}}}}}},"get":{"operationId":"listSubnets","responses":{"200":{"description":"Authorized Subnet page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubnetPage"}}}}}}},
    "/subnets/{resource_id}": {"get":{"operationId":"getSubnet","responses":{"200":{"description":"Current logical Subnet","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Subnet"}}}}}},"patch":{"operationId":"updateSubnet","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"New desired revision"}}},"delete":{"operationId":"deleteSubnet","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"202":{"description":"Retirement Operation accepted"}}}},
    "/ports": {"post":{"operationId":"createPort","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PortDesired"}}}},"responses":{"201":{"description":"Unattached logical Port committed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Port"}}}}}},"get":{"operationId":"listPorts","responses":{"200":{"description":"Authorized Port page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PortPage"}}}}}}},
    "/ports/{resource_id}": {"get":{"operationId":"getPort","responses":{"200":{"description":"Current logical Port","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Port"}}}}}},"patch":{"operationId":"updatePort","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"New desired revision"}}},"delete":{"operationId":"deletePort","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"202":{"description":"Identity-safe retirement Operation accepted"}}}},
    "/volumes": {"post":{"operationId":"createVolume","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VolumeDesired"}}}},"responses":{"201":{"description":"Backend-neutral Volume committed and KIM-selected materialization accepted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Volume"}}}}}},"get":{"operationId":"listVolumes","responses":{"200":{"description":"Authorized Volume page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VolumePage"}}}}}}},
    "/volumes/{resource_id}": {"get":{"operationId":"getVolume","responses":{"200":{"description":"Current backend-neutral Volume","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Volume"}}}}}},"patch":{"operationId":"updateVolume","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"New logical desired revision"}}},"delete":{"operationId":"deleteVolume","parameters":[{"$ref":"#/components/parameters/IfMatch"}],"responses":{"202":{"description":"Attachment/capacity-fenced retirement Operation accepted"}}}},
    "/operations/{operation_id}": {
      "get":{"operationId":"getOperation","parameters":[{"name":"operation_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Public asynchronous Operation projection","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Operation"}}}},"404":{"$ref":"#/components/responses/Problem"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "External-IdP human or automation access token. Host Agent and backend credentials are not accepted.",
        "flows": {
          "authorizationCode": {"authorizationUrl": "https://idp.example.invalid/oauth2/authorize", "tokenUrl": "https://idp.example.invalid/oauth2/token", "scopes": {}},
          "clientCredentials": {"tokenUrl": "https://idp.example.invalid/oauth2/token", "scopes": {}}
        }
      }
    },
    "parameters": {
      "ProjectID": {"name": "project_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/ProjectID"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 255}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$"}},
      "RequestID": {"name": "X-Request-ID", "in": "header", "required": false, "description": "Client correlation hint. KIM returns its own trusted request ID.", "schema": {"type": "string", "maxLength": 255}}
    },
    "headers": {
      "ETag": {"description": "Quoted persistent desired Project revision", "schema": {"type": "string", "pattern": "^\\\"[1-9][0-9]*\\\"$"}},
      "RequestID": {"description": "KIM-generated request correlation ID", "schema": {"type": "string"}}
    },
    "responses": {
      "Problem": {"description": "RFC 9457 compatible stable error", "headers": {"X-Request-ID": {"$ref": "#/components/headers/RequestID"}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    },
    "schemas": {
      "ProjectID": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "x-kim-field-class": ["COMPUTED", "IMMUTABLE"]},
      "FlavorID": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","x-kim-field-class":["COMPUTED","IMMUTABLE"]},
      "AvailabilityPolicyID":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","x-kim-field-class":["COMPUTED","IMMUTABLE"]},
      "ImageID":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","x-kim-field-class":["COMPUTED","IMMUTABLE"]},
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "deleteProtection", "revision", "createdAt", "updatedAt"],
        "properties": {
          "id": {"$ref": "#/components/schemas/ProjectID"},
          "name": {"type": "string", "minLength": 1, "maxLength": 255, "x-kim-field-class": ["REQUIRED_DESIRED"]},
          "deleteProtection": {"type": "boolean", "x-kim-field-class": ["OPTIONAL_DESIRED"]},
          "revision": {"type": "integer", "format": "int64", "minimum": 1, "readOnly": true, "x-kim-field-class": ["COMPUTED"]},
          "createdAt": {"type": "string", "format": "date-time", "readOnly": true, "x-kim-field-class": ["COMPUTED"]},
          "updatedAt": {"type": "string", "format": "date-time", "readOnly": true, "x-kim-field-class": ["COMPUTED"]}
        },
        "x-kim-resource": {"resourceType": "PROJECT", "identityField": "id", "revisionField": "revision", "scope": "SYSTEM", "importIdentifierFormat": "project/<uuid>", "mutationMode": "SYNCHRONOUS_AUTHORITY_COMMIT", "deleteSemantics":"PROTECTED_DEPENDENCY_FENCED_TOMBSTONE", "replacementSemantics":"IN_PLACE_NEW_REVISION", "sensitiveFields":[], "internalOnlyFields":[], "physicalIncarnationFields": []}
      },
      "ProjectCreate": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 255, "x-kim-field-class": ["REQUIRED_DESIRED"]}, "deleteProtection": {"type": "boolean", "default": false, "x-kim-field-class": ["OPTIONAL_DESIRED"]}}
      },
      "ProjectPatch": {
        "type": "object", "additionalProperties": false, "minProperties": 1,
        "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 255, "x-kim-field-class": ["REQUIRED_DESIRED"]}, "deleteProtection": {"type": "boolean", "x-kim-field-class": ["OPTIONAL_DESIRED"]}}
      },
      "ProjectPage": {
        "type": "object", "additionalProperties": false, "required": ["items"],
        "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Project"}}, "nextCursor": {"type": "string"}}
      },
      "FlavorDesired": {
        "type":"object","additionalProperties":false,"required":["projectId","name","vcpus","memoryMiB","rootDiskGiB","numaPolicy","cpuAllocation","cpuPinning"],
        "properties": {
          "projectId":{"$ref":"#/components/schemas/ProjectID","x-kim-field-class":["REQUIRED_DESIRED","IMMUTABLE"]},
          "name":{"type":"string","minLength":1,"maxLength":255,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "vcpus":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "memoryMiB":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "rootDiskGiB":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "numaPolicy":{"type":"string","enum":["NONE","REQUIRED"],"x-kim-field-class":["REQUIRED_DESIRED"]},
          "numaNodes":{"type":["integer","null"],"minimum":1,"x-kim-field-class":["OPTIONAL_DESIRED"]},
          "hugePageSizeKiB":{"type":["integer","null"],"minimum":1,"x-kim-field-class":["OPTIONAL_DESIRED"]},
          "cpuAllocation":{"type":"string","enum":["SHARED","DEDICATED"],"x-kim-field-class":["REQUIRED_DESIRED"]},
          "cpuPinning":{"type":"boolean","x-kim-field-class":["REQUIRED_DESIRED"]},
          "deleteProtection":{"type":"boolean","default":false,"x-kim-field-class":["OPTIONAL_DESIRED"]}
        }
      },
      "FlavorPatch": {"type":"object","additionalProperties":false,"minProperties":1,"properties":{"name":{"type":"string","minLength":1,"maxLength":255},"vcpus":{"type":"integer","minimum":1},"memoryMiB":{"type":"integer","minimum":1},"rootDiskGiB":{"type":"integer","minimum":1},"numaPolicy":{"type":"string","enum":["NONE","REQUIRED"]},"numaNodes":{"type":["integer","null"],"minimum":1},"hugePageSizeKiB":{"type":["integer","null"],"minimum":1},"cpuAllocation":{"type":"string","enum":["SHARED","DEDICATED"]},"cpuPinning":{"type":"boolean"},"deleteProtection":{"type":"boolean"}},"x-kim-patch-semantics":"TYPED_PARTIAL_ABSENT_UNCHANGED_NULL_ONLY_FOR_OPTIONAL"},
      "Flavor": {
        "type":"object","additionalProperties":false,"required":["id","projectId","name","vcpus","memoryMiB","rootDiskGiB","numaPolicy","cpuAllocation","cpuPinning","deleteProtection","revision","createdAt","updatedAt"],
        "properties": {
          "id":{"$ref":"#/components/schemas/FlavorID"},
          "projectId":{"$ref":"#/components/schemas/ProjectID","x-kim-field-class":["REQUIRED_DESIRED","IMMUTABLE"]},
          "name":{"type":"string","minLength":1,"maxLength":255,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "vcpus":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "memoryMiB":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "rootDiskGiB":{"type":"integer","minimum":1,"x-kim-field-class":["REQUIRED_DESIRED"]},
          "numaPolicy":{"type":"string","enum":["NONE","REQUIRED"],"x-kim-field-class":["REQUIRED_DESIRED"]},
          "numaNodes":{"type":["integer","null"],"minimum":1,"x-kim-field-class":["OPTIONAL_DESIRED"]},
          "hugePageSizeKiB":{"type":["integer","null"],"minimum":1,"x-kim-field-class":["OPTIONAL_DESIRED"]},
          "cpuAllocation":{"type":"string","enum":["SHARED","DEDICATED"],"x-kim-field-class":["REQUIRED_DESIRED"]},
          "cpuPinning":{"type":"boolean","x-kim-field-class":["REQUIRED_DESIRED"]},
